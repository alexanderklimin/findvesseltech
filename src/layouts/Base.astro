---
import { SITE_NAME, NOINDEX } from '../data/site.js';

interface Crumb { name: string; path: string }
interface Props {
  title: string;
  description: string;
  crumbs?: Crumb[];
  jsonLd?: Record<string, unknown>[];
  noindex?: boolean;
}

const { title, description, crumbs = [], jsonLd = [] } = Astro.props;
const noindex = NOINDEX || Astro.props.noindex;
const canonical = new URL(Astro.url.pathname, Astro.site);
const current = Astro.url.pathname;
const branded = `${title} | ${SITE_NAME}`;
const fullTitle = current === '/' || branded.length > 65 ? title : branded;

const nav = [
  // Add Equipment here when equipment pages exist.
  { href: '/request/', label: 'Request a technician' },
  { href: '/surveys/', label: 'Surveys' },
  { href: '/tools/', label: 'Tools' },
];

const schemas = [...jsonLd];
if (crumbs.length > 1) {
  schemas.push({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: crumbs.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.name, item: new URL(c.path, Astro.site).href })),
  });
}
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b3954" />
    {noindex ? <meta name="robots" content="noindex, nofollow" /> : <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {schemas.map((s) => <script is:inline type="application/ld+json" set:html={JSON.stringify(s).replace(/</g, '\\u003c')} />)}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap bar">
        <a class="brand" href="/">
          <svg width="22" height="22" viewBox="0 0 32 32" aria-hidden="true"><path d="M16 6v20M10 12a8 8 0 0 1 12 0M7 9a12 12 0 0 1 18 0" stroke="currentColor" stroke-width="2.6" fill="none" stroke-linecap="round"/><circle cx="16" cy="16" r="2.6" fill="currentColor"/></svg>
          {SITE_NAME}
        </a>
        <nav aria-label="Main">
          {nav.map((n) => <a href={n.href} aria-current={current.startsWith(n.href) ? 'page' : undefined}>{n.label}</a>)}
        </nav>
      </div>
    </header>
    <main id="main" class="wrap">
      {crumbs.length > 1 && (
        <nav class="crumbs" aria-label="Breadcrumb">
          <ol>
            {crumbs.map((c, i) => <li>{i < crumbs.length - 1 ? <a href={c.path}>{c.name}</a> : <span aria-current="page">{c.name}</span>}</li>)}
          </ol>
        </nav>
      )}
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <p><strong>{SITE_NAME}</strong> is a reference and service-request platform for ship radio and navigation equipment. It is not affiliated with any equipment manufacturer, classification society, AIS tracking service, flag administration or the ITU/IMO. Trademarks are used only to identify equipment. Always follow the manufacturer's manual for your software version and the requirements of your flag State and class.</p>
        <p class="footer-links"><a href="/request/">Request a technician</a> <a href="/contact/">Contact</a> <a href="/about/">About</a> <a href="/privacy/">Privacy</a></p>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --bg: #f7f8fa; --surface: #fff; --text: #14202b; --muted: #55636f; --line: #d9dee3;
    --brand: #0b3954; --accent: #e09f1f; --ok: #1f7a4d; --warn: #a4400f; --code: #eef2f5;
    --navy: #0b3954; --navy-2: #08263b; --sea: #0e8a7e; --sea-soft: #e3f4f1; --cta: #f28c28; --cta-text: #1b1206;
    color-scheme: light dark;
  }
  @media (prefers-color-scheme: dark) {
    :root { --bg: #0e151b; --surface: #16212a; --text: #e6ebef; --muted: #9aa8b4; --line: #2a3843; --brand: #7cc0e8; --accent: #ffd166; --ok: #5fd39a; --warn: #ff9b6a; --code: #1d2a35; --sea: #45c4b5; --sea-soft: #15302d; }
  }
  * { box-sizing: border-box; }
  [hidden] { display: none !important; }
  html { -webkit-text-size-adjust: 100%; overflow-x: clip; }
  body { margin: 0; background: var(--bg); color: var(--text); font: 16px/1.6 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; }
  a { color: var(--brand); }
  .wrap { max-width: 980px; margin: 0 auto; padding: 0 16px; }
  .skip { position: absolute; left: -999px; } .skip:focus { left: 8px; top: 8px; background: var(--surface); padding: 8px; z-index: 9; }
  .site-header { background: #0b3954; color: #fff; }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: 12px; min-height: 52px; flex-wrap: wrap; }
  .brand { color: #ffd166; font-weight: 700; text-decoration: none; display: flex; gap: 8px; align-items: center; font-size: 1.05rem; }
  .site-header nav { display: flex; gap: 4px; flex-wrap: wrap; }
  .site-header nav a { color: #fff; text-decoration: none; padding: 6px 10px; border-radius: 6px; font-size: .95rem; }
  .site-header nav a[aria-current] , .site-header nav a:hover { background: rgba(255,255,255,.14); }
  main.wrap { padding: 20px 16px 40px; }
  main.wrap:has(> .hero:first-child) { padding-top: 0; }
  h1 { font-size: 1.75rem; line-height: 1.25; margin: .3em 0 .4em; }
  h2 { font-size: 1.3rem; margin-top: 1.8em; }
  .lead { font-size: 1.08rem; color: var(--muted); max-width: 70ch; }
  .crumbs ol { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 6px; font-size: .88rem; color: var(--muted); }
  .crumbs li + li::before { content: "›"; margin-right: 6px; }
  .card { background: var(--surface); border: 1px solid var(--line); border-radius: 14px; padding: 18px; }
  .grid { display: grid; gap: 12px; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); }
  .grid a.card { text-decoration: none; color: var(--text); display: block; }
  .grid a.card { transition: transform .15s ease, box-shadow .15s ease, border-color .15s ease; }
  .grid a.card:hover { border-color: var(--sea); transform: translateY(-2px); box-shadow: 0 6px 18px rgba(11, 57, 84, .10); }
  .card .ico { display: inline-grid; place-items: center; width: 44px; height: 44px; border-radius: 12px; background: var(--sea-soft); color: var(--sea); margin-bottom: 10px; }
  .btn-cta, button.btn-cta { background: var(--cta); color: var(--cta-text); }
  .btn-cta:hover { filter: brightness(1.05); }
  @media (prefers-reduced-motion: reduce) { *, *::before, *::after { animation: none !important; transition: none !important; } }
  .grid .card strong { display: block; color: var(--brand); margin-bottom: 4px; }
  .grid .card span { color: var(--muted); font-size: .93rem; }
  .soon { opacity: .6; }
  table { border-collapse: collapse; width: 100%; background: var(--surface); font-size: .95rem; }
  th, td { text-align: left; padding: 8px 10px; border-bottom: 1px solid var(--line); vertical-align: top; }
  th { background: var(--code); }
  .table-scroll { overflow-x: auto; border: 1px solid var(--line); border-radius: 8px; }
  code, .mono { font-family: ui-monospace, "SFMono-Regular", Menlo, Consolas, monospace; background: var(--code); padding: 1px 5px; border-radius: 4px; }
  input[type=text], input[type=search] { font: inherit; font-size: 1.15rem; padding: 10px 12px; border: 2px solid var(--line); border-radius: 8px; width: 100%; background: var(--surface); color: var(--text); }
  input:focus { outline: none; border-color: var(--brand); }
  button { font: inherit; padding: 10px 16px; border-radius: 8px; border: 0; background: var(--brand); color: var(--bg); font-weight: 600; cursor: pointer; }
  .note { border-left: 4px solid var(--accent); background: var(--surface); padding: 10px 14px; border-radius: 0 8px 8px 0; }
  .source { font-size: .88rem; color: var(--muted); }
  .site-footer { border-top: 1px solid var(--line); color: var(--muted); font-size: .88rem; padding: 20px 0 32px; }
  .footer-links a { margin-right: 14px; }
</style>
